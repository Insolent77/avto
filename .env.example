# Copy to .env. Locally use: node --env-file=.env server.mjs
# For local HTTP use NODE_ENV=development; production requires HTTPS.
OWNER_PASSWORD=replace-with-a-long-unique-password
DOMAIN=booking.example.ru
PORT=8787
HOST=127.0.0.1
DB_PATH=./data/bookings.sqlite
# Set behind an HTTPS reverse proxy in production:
NODE_ENV=production
